    "@trebired/i18n": "^0.6.1",
    "@trebired/logger": "^2.7.1",
    "@trebired/seo": "^0.4.0",
    "@trebired/startup": "^0.7.1",
    "@trebired/utils": "^0.9.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@trebired/code-discipline": "^7.2.0",
    "@trebired/configs": "^0.4.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.20.1",
