  "name": "koupaliste-korycany-cz",
  "version": "1.0.0",
  "description": "Marketing site for Koupaliště Koryčany: summer swimming, pricing and opening hours. React frontend, static build, no backend.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "code-discipline gate -- bun --hot src/bin/dev.ts",
    "build": "bun src/bin/frontend/build.ts client",
    "discipline:check": "code-discipline check",
    "typecheck": "tsc --noEmit",
    "verify": "bun run discipline:check && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/poppins": "^5.2.6",
    "@trebired/bundler": "^5.13.1",
